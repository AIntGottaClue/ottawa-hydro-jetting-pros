---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Callout from './Callout.astro';
import { u, linkify, sourceSentence } from '../lib/utils';
import { faqSchema } from '../lib/seo';
const { path, title, description, h1, intro, lead = [], sections = [], faqs = [], sources = [], related = [], parent, name, location, service = false, legal = false } = Astro.props;
const crumbs = [...(parent ? [{ name: parent.name, path: parent.path }] : []), { name, path }];
const heroCrumbs = crumbs.map((c) => ({ href: c.path, label: c.name }));
---
<Base title={title} description={description} path={path} crumbs={crumbs} service={service} extraSchema={faqs.length ? [faqSchema(faqs)] : []}>
  <Hero headline={h1} intro={intro} location={location ?? name} crumbs={heroCrumbs} />
  <section class="content-section"><div class="content-inner prose">
    {lead.map((p) => <p class="lead">{p}</p>)}
    {sections.map((s) => (<>
      <h2 class="section-title" style="font-size:clamp(26px,3vw,38px)">{s.h}</h2>
      {s.ps.map((p) => <p>{p}</p>)}
    </>))}
    {related.length > 0 && (
      <div style="margin-top:32px;display:flex;gap:26px;flex-wrap:wrap">
        {related.map((r) => <a class="text-link" href={u(r.href)}>{r.label}<span aria-hidden="true">&#8599;</span></a>)}
      </div>
    )}
  </div></section>
  {faqs.length > 0 && (
    <section class="content-section" style="background:#eeece2"><div class="content-inner prose">
      <h2 class="section-title" style="font-size:clamp(26px,3vw,38px)">Questions about this drain problem</h2>
      <div class="content-list">{faqs.map((f) => <article class="faq-row"><h3>{f.q}</h3><p set:html={linkify(f.a)} /></article>)}</div>
      {sources.length > 0 && <p style="margin-top:32px" set:html={sourceSentence(sources)} />}
    </div></section>
  )}
  {!legal && <Callout />}
</Base>
